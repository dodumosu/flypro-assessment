# template settings file

# server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ALLOWED_ORIGINS=

# currency rates settings
APILAYER_EXCHANGE_RATES_API_KEY=

# redis settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=
REDIS_PASSWORD=
REDIS_USE_SSL=false

# logging settings
LOG_LEVEL=info
LOG_STYLE=json # one of colour, json or plain

# database settings
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=flypro-demo
DB_SSLMODE=disable
DB_TIMEZONE=Africa/Lagos
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE_TIME=5m
DB_CONN_MAX_LIFETIME=1h

# API settings
API_DESCRIPTION=App
API_LIST_SIZE=50
API_VERSION=1.0.0

# migration settings
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://user:password@localhost/flypro-demo
GOOSE_MIGRATION_DIR=./migrations
